<odoo>
    <!-- Tree View -->
    <record id="view_mytask_tree" model="ir.ui.view">
        <field name="name">mytask.tree</field>
        <field name="model">mytask</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="tdate"/>
                <field name="tstatus"/>
            </tree>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_mytask_form" model="ir.ui.view">
        <field name="name">mytask.form</field>
        <field name="model">mytask</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tdate"/>
                        <field name="tstatus"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="mytask_view_search" model="ir.ui.view">
        <field name="name">mytask.search</field>
        <field name="model">mytask</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tdate"/>
                <field name="tstatus"/>
            </search>
        </field>
    </record>


    <record id="mytask_action" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">mytask</field>
        <field name="view_mode">tree,form</field>  
    </record>
    <menuitem id="mytask_menu_item" name="My Tasks" action="mytask_action"/>    
</odoo>
